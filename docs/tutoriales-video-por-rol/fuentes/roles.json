{
  "administrador": {
    "title": "Tutorial del rol Administrador",
    "role": "Administrador",
    "scenes": [
      {
        "id": "escena_00_acceso",
        "narracion": "Comenzamos con el acceso del administrador. Ingrese siempre con su cuenta personal y nunca comparta la contraseña. Al entrar, confirme su nombre y el rol mostrado en el menú.",
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/login" },
          { "action": "wait", "seconds": 1.2 },
          { "action": "click", "selector": "input[type='text']" },
          { "action": "type", "value_key": "username" },
          { "action": "click", "selector": "input[type='password']" },
          { "action": "type", "value_key": "password", "char_delay_ms": 45 },
          { "action": "click", "selector": "button[type='submit']", "settle_ms": 1800 },
          { "action": "hover", "selector": "h1", "hold_ms": 1300 }
        ]
      },
      {
        "id": "escena_01_panel",
        "narracion": "El panel reúne ocupación, llegadas, salidas, ventas, caja y alertas. Pulse Actualizar al iniciar el turno y abra las tareas desde los accesos rápidos.",
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/dashboard" },
          { "action": "wait", "seconds": 1.0 },
          { "action": "hover", "selector": "h1", "hold_ms": 900 },
          { "action": "click", "role": "button", "name": "Actualizar", "settle_ms": 1400 },
          { "action": "scroll", "dy": 520 },
          { "action": "wait", "seconds": 1.2 }
        ]
      },
      {
        "id": "escena_02_operacion",
        "narracion": "Supervise la operación desde el mapa de habitaciones y la agenda de reservaciones. Revise disponibilidad, estados y fechas antes de autorizar cambios importantes.",
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/dashboard" },
          { "action": "click", "selector": "a[href='/rooms/map']", "settle_ms": 1200 },
          { "action": "hover", "selector": "h1", "hold_ms": 1000 },
          { "action": "click", "selector": "a[href='/reservations']", "settle_ms": 1200 },
          { "action": "hover", "selector": "h1", "hold_ms": 1000 },
          { "action": "click", "selector": "a[href='/rooms']", "settle_ms": 1200 },
          { "action": "hover", "selector": "h1", "hold_ms": 1100 }
        ]
      },
      {
        "id": "escena_03_fiscal",
        "narracion": "Facturación SAR permite buscar, revisar e imprimir comprobantes. En Autorizaciones CAI controle rangos, fechas, disponibilidad y documentos fiscales antes de emitir.",
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/invoices" },
          { "action": "wait", "seconds": 1.0 },
          { "action": "hover", "selector": "h1", "hold_ms": 1100 },
          { "action": "scroll", "dy": 420 },
          { "action": "click", "selector": "a[href='/authorizations']", "settle_ms": 1300 },
          { "action": "hover", "selector": "h1", "hold_ms": 1300 }
        ]
      },
      {
        "id": "escena_04_finanzas",
        "narracion": "Caja, inventario y contabilidad concentran los controles financieros del hotel. Consulte movimientos, existencias, reportes y asientos antes de aprobar cierres o ajustes.",
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/cash" },
          { "action": "wait", "seconds": 1.0 },
          { "action": "hover", "selector": "h1", "hold_ms": 900 },
          { "action": "click", "selector": "a[href='/inventory']", "settle_ms": 1200 },
          { "action": "hover", "selector": "h1", "hold_ms": 900 },
          { "action": "click", "selector": "a[href='/reports']", "settle_ms": 1200 },
          { "action": "hover", "selector": "h1", "hold_ms": 900 },
          { "action": "click", "selector": "a[href='/accounting/journal-entries']", "settle_ms": 1200 },
          { "action": "hover", "selector": "h1", "hold_ms": 1000 }
        ]
      },
      {
        "id": "escena_05_control",
        "narracion": "Administre cuentas con permisos mínimos y revise la bitácora periódicamente. Verifique respaldos y configuración, luego cierre sesión para proteger el acceso administrativo.",
        "allows_login_redirect": true,
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/users" },
          { "action": "wait", "seconds": 1.0 },
          { "action": "hover", "selector": "h1", "hold_ms": 900 },
          { "action": "click", "selector": "a[href='/audit-logs']", "settle_ms": 1200 },
          { "action": "hover", "selector": "h1", "hold_ms": 900 },
          { "action": "click", "selector": "a[href='/backups']", "settle_ms": 1200 },
          { "action": "click", "selector": "a[href='/settings']", "settle_ms": 1200 },
          { "action": "hover", "selector": "h1", "hold_ms": 900 },
          { "action": "click", "role": "button", "name": "Cerrar Sesión", "settle_ms": 1400 }
        ]
      }
    ]
  },
  "recepcion": {
