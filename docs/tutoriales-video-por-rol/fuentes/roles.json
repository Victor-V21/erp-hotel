          { "action": "click", "selector": "input[type='text']" },
          { "action": "type", "value_key": "username" },
          { "action": "click", "selector": "input[type='password']" },
          { "action": "type", "value_key": "password", "char_delay_ms": 45 },
          { "action": "click", "selector": "button[type='submit']", "settle_ms": 1800 },
          { "action": "hover", "selector": "h1", "hold_ms": 1300 }
        ]
      },
      {
        "id": "escena_01_turno",
        "narracion": "Al iniciar el turno, revise llegadas, salidas y habitaciones disponibles. El mapa muestra rápidamente qué cuartos están libres, ocupados o fuera de servicio.",
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/dashboard" },
          { "action": "wait", "seconds": 1.0 },
          { "action": "hover", "selector": "h1", "hold_ms": 900 },
          { "action": "click", "selector": "a[href='/rooms/map']", "settle_ms": 1400 },
          { "action": "hover", "selector": "h1", "hold_ms": 1200 },
          { "action": "click", "selector": "a[href='/reservations']", "settle_ms": 1300 },
          { "action": "hover", "selector": "h1", "hold_ms": 1000 }
        ]
      },
      {
        "id": "escena_02_ingreso",
        "narracion": "En Check-In busque al huésped, confirme identidad, fechas, tarifa y habitación. Consulte huéspedes y habitaciones antes de completar un ingreso dudoso.",
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/checkin" },
          { "action": "wait", "seconds": 1.0 },
          { "action": "hover", "selector": "h1", "hold_ms": 1100 },
          { "action": "click", "selector": "a[href='/guests']", "settle_ms": 1200 },
          { "action": "hover", "selector": "h1", "hold_ms": 900 },
          { "action": "click", "selector": "a[href='/rooms']", "settle_ms": 1200 },
          { "action": "hover", "selector": "h1", "hold_ms": 1100 }
        ]
      },
      {
        "id": "escena_03_estadia",
        "narracion": "Durante la estadía, el folio agrupa hospedaje y consumos. Revise cada cargo y evite duplicados antes de iniciar el Check-Out.",
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/folios" },
          { "action": "wait", "seconds": 1.0 },
          { "action": "hover", "selector": "h1", "hold_ms": 1200 },
          { "action": "scroll", "dy": 420 },
          { "action": "click", "selector": "a[href='/checkout']", "settle_ms": 1300 },
          { "action": "hover", "selector": "h1", "hold_ms": 1300 }
        ]
      },
      {
        "id": "escena_04_facturacion",
        "narracion": "Clientes conserva los datos fiscales del receptor. En Facturación SAR localice el comprobante, revise su estado y registre pagos desde la opción autorizada.",
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/customers" },
          { "action": "wait", "seconds": 1.0 },
          { "action": "hover", "selector": "h1", "hold_ms": 1100 },
          { "action": "click", "selector": "a[href='/invoices']", "settle_ms": 1300 },
          { "action": "hover", "selector": "h1", "hold_ms": 1100 },
          { "action": "scroll", "dy": 420 },
          { "action": "wait", "seconds": 1.0 }
        ]
      },
      {
        "id": "escena_05_caja",
        "narracion": "En Caja verifique el fondo, los movimientos y el efectivo contado. Explique cualquier diferencia y cierre siempre su sesión al terminar el turno.",
        "allows_login_redirect": true,
        "steps": [
          { "action": "goto", "url": "http://127.0.0.1:5174/cash" },
          { "action": "wait", "seconds": 1.0 },
          { "action": "hover", "selector": "h1", "hold_ms": 1100 },
          { "action": "scroll", "dy": 460 },
          { "action": "wait", "seconds": 1.0 },
          { "action": "click", "role": "button", "name": "Cerrar Sesión", "settle_ms": 1400 }
        ]
      }
    ]
  },
