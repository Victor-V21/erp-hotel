{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "HotelERP",
    "Audience": "HotelERP",
    "ExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AuthenticationSession": {
    "RefreshCookieName": "hotel_erp_refresh",
    "CsrfCookieName": "hotel_erp_csrf",
    "CsrfHeaderName": "X-CSRF-Token",
    "SecureCookies": true
  },
  "AuthenticationRateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "RefreshPermitLimit": 30,
    "RefreshWindowSeconds": 60,
    "ChangePasswordPermitLimit": 5,
    "ChangePasswordWindowSeconds": 300
  },
  "AuthorizationAttachments": {
    "Directory": "Uploads/authorizations",
    "MaximumSizeBytes": 10485760
  },
  "Backup": {
    "Enabled": false,
    "LocalPath": "C:\\HotelERP\\backups",
    "RunAt": "02:00",
    "PendingUploadIntervalHours": 2,
    "RetentionYears": 5,
    "GoogleDriveUploadCommand": null
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hotel-erp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
