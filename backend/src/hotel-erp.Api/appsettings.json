{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=hotel_erp;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "HotelERP",
    "Audience": "HotelERP",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "Backup": {
    "Enabled": false,
    "LocalPath": "C:\\HotelERP\\backups",
    "RunAt": "02:00",
    "PendingUploadIntervalHours": 2,
    "RetentionYears": 5,
    "GoogleDriveUploadCommand": null
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hotel-erp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
